# Vyom AI provider configuration
# Never commit a real API key.

VYOM_AI_ENABLED=true
VYOM_AI_PROVIDER=local_qwen
VYOM_ALLOW_PAID_API=false
VYOM_REMOTE_REASONING=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional local Qwen fallback through Ollama.
QWEN_LOCAL_ENABLED=true
QWEN_LOCAL_API_URL=http://127.0.0.1:11434/v1/chat/completions
QWEN_LOCAL_MODEL=qwen3.5:0.8b

# Optional explicit OpenAI-compatible provider:
# VYOM_AI_API_KEY=
# VYOM_AI_API_URL=
# VYOM_AI_MODEL=

# Optional visual screen understanding through a local Ollama service only.
# Disabled by default. No screenshot leaves this computer.
VYOM_VISION_ENABLED=false
VYOM_VISION_API_URL=http://127.0.0.1:11434/api/chat
VYOM_VISION_MODEL=moondream
VYOM_VISION_TIMEOUT=60
