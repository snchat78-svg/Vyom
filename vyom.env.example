# Vyom runtime AI configuration
# Copy this file to "vyom.env" beside Vyom.exe and put your own API key here.
# Never commit the real key.

VYOM_AI_ENABLED=true
VYOM_AI_PROVIDER=auto
VYOM_REMOTE_REASONING=false

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional local Qwen fallback through Ollama.
# Ollama must be installed and the selected model must be available locally.
QWEN_LOCAL_ENABLED=false
QWEN_LOCAL_API_URL=http://127.0.0.1:11434/v1/chat/completions
QWEN_LOCAL_MODEL=qwen3.5:0.8b

# Optional explicit OpenAI-compatible endpoint.
# When set, it remains the primary endpoint. If it is a Gemini endpoint,
# Local Qwen can still be used as the configured fallback.
# VYOM_AI_API_KEY=
# VYOM_AI_API_URL=
# VYOM_AI_MODEL=
