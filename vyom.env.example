# Vyom runtime AI configuration
# Copy this file to "vyom.env" beside Vyom.exe and put your own API key here.
# Never commit the real key.

VYOM_AI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash
# Optional:
# VYOM_AI_API_URL=https://generativelanguage.googleapis.com/v1beta/openai/chat/completions
