{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Vyom User-Approved Memory Record v1 (design-only at M9.1)",
  "description": "Proposed user-approved personal-memory record. Not yet connected to runtime storage. Only user-approved, bounded correction/preference/verified-workflow metadata is allowed; no raw transcript or executable plan.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "memory_id",
    "memory_type",
    "value",
    "scope",
    "provenance",
    "confidence",
    "created_at",
    "updated_at",
    "expires_at",
    "approval",
    "lifecycle"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "memory_id": {
      "type": "string",
      "format": "uuid",
      "maxLength": 64
    },
    "memory_type": {
      "type": "string",
      "enum": [
        "correction",
        "preference",
        "verified_workflow"
      ]
    },
    "value": {
      "type": "object",
      "maxProperties": 8,
      "additionalProperties": false,
      "properties": {
        "surface_form": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "preferred_form": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "language": {
          "type": "string",
          "maxLength": 32
        },
        "context_hint": {
          "type": "string",
          "maxLength": 256
        },
        "key": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96
        },
        "value_text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256
        },
        "scope_hint": {
          "type": "string",
          "maxLength": 96
        },
        "workflow_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128
        },
        "display_name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160
        },
        "verified_summary": {
          "type": "string",
          "minLength": 1,
          "maxLength": 512
        }
      }
    },
    "scope": {
      "type": "string",
      "enum": [
        "global",
        "application",
        "workflow"
      ]
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "source_ref"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "explicit_correction",
            "explicit_preference",
            "verified_workflow"
          ]
        },
        "source_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Opaque turn/verification reference; never raw user text."
        }
      }
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1,
      "description": "Confidence in interpreting the approved preference/correction, not probability that a factual claim is true."
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "actor",
        "consent_version",
        "decision_ref",
        "decided_at"
      ],
      "properties": {
        "status": {
          "const": "approved"
        },
        "actor": {
          "const": "user"
        },
        "consent_version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64
        },
        "decision_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 160,
          "description": "Opaque consent-decision ID, not a transcript or token."
        },
        "decided_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "lifecycle": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "expired",
        "revoked"
      ]
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "memory_type": {
            "const": "correction"
          }
        },
        "required": [
          "memory_type"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "required": [
              "surface_form",
              "preferred_form"
            ]
          },
          "provenance": {
            "properties": {
              "kind": {
                "const": "explicit_correction"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "memory_type": {
            "const": "preference"
          }
        },
        "required": [
          "memory_type"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "required": [
              "key",
              "value_text"
            ]
          },
          "provenance": {
            "properties": {
              "kind": {
                "const": "explicit_preference"
              }
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "memory_type": {
            "const": "verified_workflow"
          }
        },
        "required": [
          "memory_type"
        ]
      },
      "then": {
        "properties": {
          "value": {
            "required": [
              "workflow_id",
              "display_name",
              "verified_summary"
            ]
          },
          "provenance": {
            "properties": {
              "kind": {
                "const": "verified_workflow"
              }
            }
          }
        }
      }
    }
  ]
}
